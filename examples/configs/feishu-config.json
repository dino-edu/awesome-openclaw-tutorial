{
  "gateway": {
    "auth": {
      "mode": "token",
      "token": "your-secret-token-here"
    }
  },
  "platforms": [
    {
      "type": "feishu",
      "config": {
        "appId": "your-feishu-app-id",
        "appSecret": "your-feishu-app-secret",
        "encryptKey": "your-encrypt-key",
        "verificationToken": "your-verification-token"
      }
    }
  ],
  "agents": [
    {
      "name": "Trợ lý Lark Feishu",
      "model": "deepseek-chat",
      "systemPrompt": "Bạn là một trợ lý bot Lark/Feishu, giúp người dùng xử lý các công việc văn phòng và quản lý dự án."
    }
  ]
}
